{
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/demo-store/(.*)", "destination": "/demo-store/$1" },
    { "source": "/orb.js", "destination": "/orb.js" },
    { "source": "/standalone-demo.html", "destination": "/standalone-demo.html" },
    { "source": "/((?!api/|demo-store/|orb\\.js|standalone-demo\\.html|assets/).*)", "destination": "/index.html" }
  ]
}
